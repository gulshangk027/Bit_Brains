# MuleNet AI - Backend Environment Variables
# -------------------------------------------------------------
# Host port (automatically provided by cloud platforms like Render / Railway via $PORT)
PORT=8000

# Allowed CORS Origins (comma-separated). 
# By default, https://bit-brains-liart.vercel.app and preview domains (*.vercel.app) are allowed.
ALLOWED_ORIGINS=https://bit-brains-liart.vercel.app,http://localhost:5173,http://localhost:3000
