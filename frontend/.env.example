# MuleNet AI - Frontend Environment Variables
# -------------------------------------------------------------
# On Vercel: Set this in Project Settings -> Environment Variables
# Value: The full URL to your deployed Python backend (e.g., Render, Railway, AWS, Fly.io, etc.)
# Example: https://mulenet-backend.onrender.com
#
# In local development: Defaults to http://localhost:8000 automatically
VITE_API_URL=http://localhost:8000
